---
/* The lines. Each office job is a line: a route strip of what changes, the copy, and a working
   example beside it. Every example runs in the page; nothing is sent. */
import { services, website, notOffered } from '../site';
import { serviceLines as lines } from '../map';
import Arrow from './Arrow.astro';

const routes: Record<string, string[]> = {
  quotes: ['A customer asks', 'The quote builds itself', 'It goes out', 'A follow-up'],
  billing: ['A bill or a payment', 'Read and entered', 'In QuickBooks', 'Reminders on unpaid'],
  scheduling: ['A request', 'A time that works', 'Confirmed', 'Reminded the day before'],
  paperwork: ['What you need', 'What came in', 'What is missing', 'A nudge until it arrives'],
};

/* The relay examples: a request travels the line and every stop lights as it passes. */
const relays: Record<string, { button: string; stops: string[]; messages: string[] }> = {
  quotes: {
    button: 'Send a test quote request',
    stops: ['Request', 'Quote built', 'Emailed', 'Follow-up set', 'Deposit'],
    messages: [
      'A customer asked for a quote through your form.',
      'The quote was built from your price list.',
      'Quote #1043 went out by email.',
      'A follow-up is set for three days from now, in case nobody answers.',
      'A deposit link is ready for when they say yes. Example only, nothing was sent.',
    ],
  },
  billing: {
    button: 'Send a test bill',
    stops: ['New bill', 'Details read', 'QuickBooks', 'Invoice late', 'Reminder'],
    messages: [
      'A supplier’s bill arrived by email.',
      'The vendor, date and amount were read off it.',
      'It was entered in QuickBooks, ready for you to approve.',
      'Meanwhile, invoice #2207 to a customer is a week past due.',
      'A polite reminder went out for it. Example only, nothing was sent.',
    ],
  },
  scheduling: {
    button: 'Send a test booking',
    stops: ['Request', 'Time picked', 'Confirmed', 'Calendar', 'Reminder'],
    messages: [
      'Someone asked to book a job.',
      'They picked Thursday at 9, a time you had open.',
      'They got a confirmation right away.',
      'It landed on your calendar with their address and notes.',
      'A reminder goes out Wednesday morning. Example only, nothing was sent.',
    ],
  },
};

/* The paperwork tracker: what came in and what is still missing. Fictional rows. */
const tracker = [
  ['Order 1041', 'Signed agreement', 'Received', ''],
  ['Order 1042', 'Vehicle title', 'Missing', 'Reminder Thursday'],
  ['New client: Hart', 'Tax documents', '2 of 3 in', 'Reminder Friday'],
];
---

<section id="lines" class="section" aria-labelledby="lines-title">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 id="lines-title">What I set up.</h2>
      <p>Four jobs most small offices still do by hand, each one a line on the map. Start with one. Fixed price, written plan, set up on your accounts.</p>
    </div>

    {lines.map((L, i) => {
      const s = services[i];
      const relay = relays[L.slug];
      return (
        <article id={`line-${L.slug}`} class="line-entry reveal" data-line={L.slug}>
          <div class="route" aria-label={`What the ${L.name} covers`}>
            {routes[L.slug].map((stop) => (
              <span class="stop"><i class="dot" aria-hidden="true"></i><span>{stop}</span></span>
            ))}
          </div>
          <div class="line-body">
            <div class="line-copy">
              <h3>{s.name}</h3>
              <p class="line-name"><span class="swatch" aria-hidden="true"></span>{L.name}</p>
              <p class="outcome">{s.before}</p>
              <p class="desc">{s.description}</p>
              <div class="line-actions">
                <a class="btn small" href="#contact">{s.offer}<Arrow /></a>
                <span class="price">{s.price}</span>
              </div>
              <details>
                <summary>Optional upkeep<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8h10M8 3v10" /></svg></summary>
                <p>{s.upkeep}</p>
              </details>
            </div>

            <div class="line-proof">
              {relay && (
                <div class="instrument" data-relay data-messages={JSON.stringify(relay.messages)}>
                  <svg class="relay" viewBox="0 0 560 110" aria-hidden="true">
                    <path class="relay-track" d="M30 44 H530" />
                    <path class="relay-lit" d="M30 44 H530" pathLength="1" />
                    {relay.stops.map((name, k) => (
                      <g class="relay-stop" data-relay-stop transform={`translate(${30 + k * (500 / (relay.stops.length - 1))} 44)`}>
                        <circle r="9" />
                        <text y="40" text-anchor="middle">{name}</text>
                      </g>
                    ))}
                    <circle class="relay-pulse" r="7">
                      <animateMotion dur="2.6s" begin="indefinite" fill="freeze" path="M30 44 H530" />
                    </circle>
                  </svg>
                  <div class="instrument-foot">
                    <button class="btn small" type="button" data-run-relay>{relay.button}<Arrow /></button>
                    <span class="status" role="status" data-relay-status>An example that runs here, in the page. Nothing is sent.</span>
                  </div>
                </div>
              )}

              {L.slug === 'paperwork' && (
                <div class="instrument" data-tracker>
                  <table>
                    <caption class="visually-hidden">An example paperwork tracker with fictional orders and clients</caption>
                    <thead><tr><th scope="col">For</th><th scope="col">Document</th><th scope="col">Status</th><th scope="col">Next</th></tr></thead>
                    <tbody>{tracker.map((r) => (
                      <tr class:list={{ waiting: r[2] !== 'Received' }}>
                        <td>{r[0]}</td><td>{r[1]}</td><td class="state"><i class="state-dot" aria-hidden="true"></i>{r[2]}</td><td class="next">{r[3] || '—'}</td>
                      </tr>
                    ))}</tbody>
                  </table>
                  <p class="status">An example with made-up orders. Yours would list your own jobs and clients, and the reminders send themselves.</p>
                </div>
              )}
            </div>
          </div>
        </article>
      );
    })}

    <article class="website-entry reveal">
      <div class="website-copy">
        <h3>{website.title}</h3>
        <p class="desc">{website.body}</p>
        <div class="line-actions">
          <a class="btn small ghost" href="#contact">Ask about a website<Arrow /></a>
        </div>
      </div>
      <figure class="proof-site">
        <a href="/work/dinesense-site" aria-label="Read the dinesense.app case study"><img src="/work/dinesense-site.jpg" alt="The DineSense website at desktop width" width="1400" height="1006" loading="lazy" decoding="async" /></a>
        <figcaption><span>dinesense.app, a real site I built.</span><a class="text-link" href="/work/dinesense-site">Read the case study<Arrow diagonal /></a></figcaption>
      </figure>
    </article>

    <p class="not-offered reveal">{notOffered}</p>
  </div>
</section>

<style>
  #lines {
    background: var(--water-2);
    border-block: 1px solid var(--hair-soft);
  }

  .section-head p {
    max-width: 40ch;
  }

  .line-entry {
    padding-block: 44px 64px;
    border-top: 1px solid var(--hair);
    scroll-margin-top: 96px;
  }

  /* The route strip: a bar in the line's colour with the deliverables as its stations. */
  .route {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 2px;
  }

  .route::before {
    content: '';
    position: absolute;
    left: 6px;
    right: 6px;
    top: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--c);
  }

  .stop {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 14px;
    text-align: center;
    font: 500 13px/1.3 var(--font-display);
    color: var(--muted);
    max-width: 12ch;
  }

  .stop:first-child {
    justify-items: start;
    text-align: left;
  }

  .stop:last-child {
    justify-items: end;
    text-align: right;
  }

  .stop .dot {
    width: 10px;
    height: 10px;
    margin-top: 3px;
  }

  .line-body {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    margin-top: 44px;
    align-items: start;
  }

  .line-name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 500 13px/1 var(--font-display);
    color: var(--muted);
  }

  .swatch {
    width: 28px;
    height: 7px;
    border-radius: 999px;
    background: var(--c);
  }

  h3 {
    font-size: clamp(26px, 2.6vw, 36px);
  }

  .line-name {
    margin-top: 14px;
  }

  .outcome {
    font-size: 18px;
    margin-top: 24px;
  }

  .desc {
    color: var(--muted);
    font-size: 15.5px;
    line-height: 1.65;
    margin-top: 10px;
    max-width: 46ch;
  }

  .line-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 20px;
    margin-top: 26px;
  }

  .btn.small {
    padding: 12px 18px 12px 20px;
    font-size: 14px;
  }

  .price {
    font-size: 13px;
    color: var(--dim);
  }

  details {
    margin-top: 22px;
    max-width: 46ch;
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    cursor: pointer;
    color: var(--dim);
    font-size: 13px;
    padding-block: 8px;
    border-top: 1px solid var(--hair-soft);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary svg {
    width: 13px;
    transition: transform 200ms;
  }

  details[open] summary svg {
    transform: rotate(45deg);
  }

  details p {
    font-size: 13.5px;
    color: var(--muted);
    padding-block: 6px 10px;
  }

  /* Proof: real work or a working example, plain on the ground. */
  .proof-site img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    box-shadow: 0 0 0 1px var(--hair), 0 40px 80px -40px rgb(0 0 0 / 0.9);
  }

  .proof-site figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 20px;
    margin-top: 16px;
    font-size: 13.5px;
    color: var(--muted);
  }

  .instrument {
    padding-top: 6px;
  }

  .instrument-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
    margin-top: 22px;
  }

  .status {
    font-size: 13px;
    color: var(--muted);
    max-width: 44ch;
  }

  /* Relay instrument: a straight stretch of the line that a test order travels along. */
  .relay {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-display);
  }

  .relay-track {
    fill: none;
    stroke: var(--hair);
    stroke-width: 8;
    stroke-linecap: round;
  }

  .relay-lit {
    fill: none;
    stroke: var(--c);
    stroke-width: 8;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .is-running .relay-lit {
    transition: stroke-dashoffset 2600ms linear;
    stroke-dashoffset: 0;
  }

  .is-done .relay-lit {
    stroke-dashoffset: 0;
  }

  .relay-stop circle {
    fill: var(--water-2);
    stroke: var(--ink);
    stroke-width: 3.5;
    transition: fill 250ms ease;
  }

  .relay-stop.is-lit circle {
    fill: var(--c);
  }

  .relay-stop text {
    fill: var(--muted);
    font-size: 13px;
    font-weight: 500;
    transition: fill 250ms ease;
  }

  .relay-stop.is-lit text {
    fill: var(--ink);
  }

  .relay-pulse {
    fill: var(--ink);
    stroke: var(--c);
    stroke-width: 3;
    opacity: 0;
  }

  .is-running .relay-pulse {
    opacity: 1;
  }

  .btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  /* Collector instrument: the rows as they land. */
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  th,
  td {
    text-align: left;
    padding: 12px 10px 12px 0;
    border-bottom: 1px solid var(--hair);
  }

  th {
    font: 500 12.5px/1.3 var(--font-display);
    color: var(--c);
    letter-spacing: 0.02em;
  }

  td.num {
    font-variant-numeric: tabular-nums;
  }

  /* Paperwork tracker: what is in and what is still missing. */
  td.state {
    white-space: nowrap;
  }

  .state-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--c);
    vertical-align: 1px;
  }

  tr.waiting .state-dot {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }

  tr.waiting .next {
    color: var(--ink);
  }

  td.next {
    color: var(--dim);
  }

  /* Websites: an add-on, set apart from the four lines by a hairline and no route strip. */
  .website-entry {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    padding-block: 56px 64px;
    border-top: 1px solid var(--hair);
  }

  .website-entry .desc {
    margin-top: 14px;
  }

  .instrument .status {
    margin-top: 16px;
    display: block;
  }

  .not-offered {
    font-size: 13px;
    color: var(--dim);
    border-top: 1px solid var(--hair);
    padding-top: 24px;
  }

  @media (max-width: 860px) {
    .line-body {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .route {
      flex-direction: column;
      gap: 18px;
      padding-left: 26px;
    }

    /* the bar and the 10px rings share a centre line at 5px */
    .route::before {
      left: 1.5px;
      right: auto;
      top: 6px;
      bottom: 6px;
      width: 7px;
      height: auto;
    }

    .stop,
    .stop:first-child,
    .stop:last-child {
      grid-template-columns: auto 1fr;
      justify-items: start;
      text-align: left;
      align-items: center;
      gap: 14px;
      max-width: none;
    }

    .stop .dot {
      margin: 0 0 0 -26px;
    }

    .website-entry {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    table {
      font-size: 13.5px;
    }
  }

  @media (max-width: 560px) {
    /* the relay stretch scales down with the screen; its labels must not */
    .relay-stop text {
      font-size: 21px;
    }

    .relay-stop circle {
      r: 11;
      stroke-width: 4.5;
    }

    .relay-pulse {
      r: 9;
    }
  }
</style>

---
import { services, notOffered } from '../site';
---

<section id="services" class="section" aria-labelledby="services-title">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 id="services-title">Services</h2>
      <p>Four things I build. Each has a fixed-price starting point and an optional plan to keep it running.</p>
    </div>

    <ol class="rows">
      {
        services.map((s, i) => (
          <li id={`svc-${s.slug}`} class="row reveal" data-ink>
            <span class="idx num dim">{String(i + 1).padStart(2, '0')}</span>
            <div class="row-main">
              <h3>{s.name}</h3>
              <p class="desc muted">{s.description}</p>
              <p class="small dim upkeep">{s.upkeep}</p>
            </div>
            <div class="row-offer">
              <span class="offer-name">{s.offer}</span>
              <span class="offer-price num muted">starting at <b>{s.price}</b></span>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="small dim not-offered reveal">{notOffered}</p>
  </div>
</section>

<style>
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hair);
  }

  .row {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    gap: 12px clamp(20px, 4vw, 64px);
    padding-block: clamp(28px, 3.6vw, 44px);
    border-bottom: 1px solid var(--hair);
    align-items: start;
    transition: background-color var(--t-slow) ease;
  }

  .idx {
    font: 500 14px/1.6 var(--font-display);
    padding-top: 6px;
  }

  .row-main {
    display: grid;
    gap: 12px;
    max-width: 58ch;
  }

  .desc {
    font-size: 16.5px;
    line-height: 1.5;
  }

  .upkeep {
    line-height: 1.45;
  }

  .row-offer {
    display: grid;
    gap: 6px;
    text-align: right;
    padding-top: 6px;
    min-width: 12ch;
  }

  .offer-name {
    font: 500 15px/1.3 var(--font-display);
  }

  .offer-price {
    font-size: 14.5px;
  }

  .offer-price b {
    font-weight: 500;
    color: var(--ink);
  }

  .not-offered {
    margin-top: 28px;
  }

  @media (max-width: 719px) {
    .row {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .idx {
      padding-top: 0;
    }

    .row-offer {
      text-align: left;
      border-top: 1px solid var(--hair-soft);
      padding-top: 14px;
    }
  }
</style>

---
import { services, notOffered, email } from '../site';
import Arrow from './Arrow.astro';
const outcomes = ['Make a good first impression.', 'Give the busywork a way out.', 'Stop collecting it by hand.', 'Know what is actually happening.'];
const symbols = ['M3 5h18v14H3zM3 9h18M7 7h.01M10 7h.01', 'M4 7h6v6H4zM14 11h6v6h-6zM10 10h7v1M7 13v5h7', 'M5 3h10l4 4v14H5zM14 3v5h5M8 12h8M8 16h6', 'M4 4v16h17M8 15v-4M13 15V7M18 15v-6'];
---
<section id="services" class="section" aria-labelledby="services-title">
  <div class="wrap services-layout">
    <div class="services-intro reveal"><h2 id="services-title">What needs<br />to work better?</h2><p>Start with one problem. I can build the part you need, or connect the whole thing.</p><p class="service-terms">Fixed scope. Written quote.<br />Source code included.</p><a class="text-link" href="#contact">Let's figure it out<Arrow /></a></div>
    <div class="service-list">
      {services.map((s, i) => <article id={`svc-${s.slug}`} class="service reveal">
        <div class="service-heading"><svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={symbols[i]} /></svg><h3>{s.name}</h3></div>
        <p class="outcome">{outcomes[i]}</p><p class="desc">{s.description}</p>
        <div class="service-bottom"><a href={`mailto:${email}?subject=${encodeURIComponent(s.name + ' project')}`}>{s.offer}<Arrow diagonal /></a><span>{s.price}</span></div>
        <details><summary>Ongoing support<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8h10M8 3v10" /></svg></summary><p>{s.upkeep}</p></details>
      </article>)}
      <p class="not-offered">{notOffered}</p>
    </div>
  </div>
</section>
<style>
  #services { background: #0d1016; border-block: 1px solid var(--hair-soft); }
  .services-layout { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(40px, 8vw, 120px); align-items: start; }
  .services-intro { position: sticky; top: 120px; }
  .services-intro h2 { line-height: 1.13; }
  .services-intro > p { margin-top: 26px; max-width: 29ch; color: var(--muted); font-size: 17px; }
  .services-intro .service-terms { font-size: 13px; line-height: 1.9; color: var(--dim); margin-top: 34px; }
  .services-intro .text-link { margin-top: 28px; }
  .service { border-top: 1px solid var(--hair); padding-block: 30px 34px; scroll-margin-top: 100px; }
  .service-heading { display: flex; gap: 16px; align-items: center; }
  .service-icon { width: 25px; height: 25px; color: var(--cobalt-light); flex: none; }
  .service h3 { font-size: clamp(20px, 2vw, 26px); }
  .outcome { font-size: 17px; margin-top: 24px; }
  .desc { color: var(--muted); font-size: 15px; line-height: 1.7; margin-top: 10px; }
  .service-bottom { margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 20px; }
  .service-bottom a { display: inline-flex; align-items: center; gap: 12px; font-size: 13px; text-decoration: none; }
  .service-bottom a :global(svg) { width: 15px; color: var(--cobalt-light); }
  .service-bottom > span { font-size: 12px; color: var(--dim); }
  details { margin-top: 20px; }
  summary { display: flex; justify-content: space-between; align-items: center; list-style: none; cursor: pointer; color: var(--dim); font-size: 12px; padding-block: 8px; }
  summary::-webkit-details-marker { display: none; }
  summary svg { width: 13px; transition: transform 200ms; }
  details[open] summary svg { transform: rotate(45deg); }
  details p { font-size: 13px; color: var(--muted); padding-block: 6px 10px; }
  .not-offered { font-size: 12px; color: var(--dim); border-top: 1px solid var(--hair); padding-top: 24px; }
  @media (max-width: 800px) { .services-layout { grid-template-columns: 1fr; } .services-intro { position: static; } .services-intro > p { max-width: 42ch; } .services-intro .service-terms { margin-top: 20px; } }
</style>

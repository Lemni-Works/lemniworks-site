---
import { hero } from '../site';
import Arrow from './Arrow.astro';
import NetworkMap from './NetworkMap.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-stage">
    <div class="hero-map"><NetworkMap /></div>
    <div class="wrap hero-copy">
      <h1 id="hero-title">Your office runs<br />on retyping.</h1>
      <p class="lede" style="--i: 90ms">{hero.lede}</p>
      <div class="hero-cta" style="--i: 180ms">
        <a class="btn" href="#contact">{hero.cta}<Arrow /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 80px;
    overflow: clip;
  }

  .hero-stage {
    display: grid;
    grid-template-areas: 'stage';
    min-height: calc(100vh - 80px);
    align-items: center;
  }

  .hero-map,
  .hero-copy {
    grid-area: stage;
  }

  .hero-map {
    width: min(100%, calc((100vh - 120px) * 1.76));
    margin-inline: auto;
    padding-block: 24px 56px;
  }

  /* The copy owns the map's empty north-west quadrant, so it never takes the wrap's auto margins. */
  .hero-copy {
    position: relative;
    z-index: 1;
    align-self: start;
    margin-inline: 0;
    max-width: calc(420px + 2 * var(--gutter));
    padding-top: clamp(28px, 7vh, 80px);
  }

  h1 {
    font-size: clamp(42px, 3.75vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .lede {
    margin-top: 22px;
    max-width: 34ch;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  .hero-cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 28px;
  }

  .hero-cta .btn {
    padding-inline: 24px;
  }

  /* Entrance: everything waits while the mark draws; when html.intro comes off it rises with --i. */
  .hero-copy > * {
    transition: opacity 900ms ease, transform 1200ms var(--ease-out);
    transition-delay: var(--i, 0ms);
  }

  :global(html.intro) .hero-copy > * {
    opacity: 0;
    transform: translateY(26px);
    transition: none;
  }

  /* Between 900 and 1100 the overlay holds with a narrower copy column. */
  @media (max-width: 1100px) and (min-width: 901px) {
    .hero-copy {
      max-width: calc(300px + 2 * var(--gutter));
    }

    h1 {
      font-size: clamp(32px, 3.3vw, 38px);
    }

    .lede {
      font-size: 15px;
      max-width: none;
    }
  }

  @media (max-width: 900px) {
    .hero-stage {
      grid-template-areas: 'copy' 'map';
      min-height: 0;
    }

    .hero-copy {
      grid-area: copy;
      max-width: calc(560px + 2 * var(--gutter));
      padding-top: clamp(28px, 6vh, 64px);
    }

    /* On a phone the map becomes a pocket map: wider than the screen, dragged sideways, cropped to
       the band around the hub so the interchange is on the first screen. */
    .hero-map {
      grid-area: map;
      width: 100%;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      padding: 40px 0 36px;
      scrollbar-width: none;
      /* a window onto the map: the band fades into the ground at its top and bottom edges */
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 6%, #000 94%, transparent);
      mask-image: linear-gradient(to bottom, transparent, #000 6%, #000 94%, transparent);
    }

    .hero-map::-webkit-scrollbar {
      display: none;
    }

    .hero-map :global(.network) {
      width: 980px;
      height: 360px;
      padding-inline: var(--gutter);
    }


  }

  @media (max-width: 560px) {
    h1 {
      font-size: clamp(38px, 10.5vw, 48px);
    }

    .lede {
      margin-top: 18px;
      font-size: 16px;
    }

    .hero-cta {
      gap: 16px;
      margin-top: 24px;
    }

    .hero-cta .btn {
      font-size: 14px;
      padding: 15px 20px;
    }

  }
</style>

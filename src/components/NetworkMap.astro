---
/* The map. Geometry lives in src/map.ts; this component draws it in Beck's grammar:
   rounded 45° lines, white station ticks with sentence-case labels, one hub capsule
   carrying the Open Path mark, and a slow train on every line. */
import { lines, linePath, stationNormal, HUB, MAP_W, MAP_H } from '../map';
import { MARK_PATH, MARK_VIEWBOX } from '../mark';

interface Props { class?: string }
const { class: cls = '' } = Astro.props;

const TICK = 16;
const dir = { n: [0, -1], s: [0, 1], e: [1, 0], w: [-1, 0] } as const;

/** Fraction of the line's length at which a station sits, for the draw-in stagger. */
function frac(points: [number, number][], s: { x: number; y: number }) {
  const seg = points.slice(1).map(([x, y], i) => Math.hypot(x - points[i][0], y - points[i][1]));
  const total = seg.reduce((a, b) => a + b, 0);
  let acc = 0;
  for (let i = 0; i < seg.length; i++) {
    const [x1, y1] = points[i];
    const [x2, y2] = points[i + 1];
    const dx = x2 - x1;
    const dy = y2 - y1;
    const t = ((s.x - x1) * dx + (s.y - y1) * dy) / (seg[i] * seg[i]);
    if (t >= -1e-6 && t <= 1 + 1e-6 && Math.hypot(x1 + t * dx - s.x, y1 + t * dy - s.y) < 0.5) return (acc + t * seg[i]) / total;
    acc += seg[i];
  }
  return 0;
}

/** Unit normal of a line's first or last segment, for the terminus bar. */
function endNormal(points: [number, number][], atEnd: boolean): [number, number] {
  const [a, b] = atEnd ? [points[points.length - 2], points[points.length - 1]] : [points[0], points[1]];
  const dx = b[0] - a[0];
  const dy = b[1] - a[1];
  const len = Math.hypot(dx, dy);
  return [-dy / len, dx / len];
}

const drawn = lines.map((L, i) => ({
  ...L,
  d: linePath(L.points),
  delay: i * 180,
  normals: [endNormal(L.points, false), endNormal(L.points, true)] as [number, number][],
  stations: L.stations.map((s) => {
    const side = s.side ?? 'n';
    let [nx, ny] = stationNormal(L, s);
    const [wx, wy] = dir[side];
    if (nx * wx + ny * wy < 0) { nx = -nx; ny = -ny; }
    const reach = s.href ? 22 : TICK + 9;
    return {
      ...s,
      x2: s.x + nx * TICK,
      y2: s.y + ny * TICK,
      lx: s.x + nx * reach,
      ly: s.y + ny * reach,
      anchor: side === 'e' ? 'start' : side === 'w' ? 'end' : 'middle',
      baseline: side === 'n' ? 'auto' : side === 's' ? 'hanging' : 'middle',
      t: frac(L.points, s).toFixed(3),
    };
  }),
}));
---

<svg class:list={['network', cls]} viewBox={`0 0 ${MAP_W} ${MAP_H}`} preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" data-map role="img" aria-label="The four lines Lemni Works runs" aria-describedby="map-desc">
  <desc id="map-desc">A transit-style map. The Storefront line runs from your site through customers to repeat orders. The Automation line carries an incoming order into your spreadsheet, your email and your team. The Data line watches the sites you choose every night and delivers clean rows to your files. The Reports line takes sales, ad spend and bookkeeping to a weekly report in your inbox. All four meet at one hub, Lemni Works in Wichita.</desc>

  {drawn.map((L) => (
    <g class="line-group" data-line={L.slug} style={`--ld: ${L.delay}ms`}>
      <path class="line" d={L.d} pathLength="1" />
      {[L.points[0], L.points[L.points.length - 1]].map(([x, y], k) => {
        const [nx, ny] = L.normals[k];
        if (L.stations.some((st) => st.href && st.x === x && st.y === y)) return null;
        return <line class="terminus" x1={x + nx * 13} y1={y + ny * 13} x2={x - nx * 13} y2={y - ny * 13} />;
      })}
      {L.stations.map((s) => s.href ? (
        <a class="station destination" href={s.href} style={`--t: ${s.t}`} aria-label={`${s.name}: read the case study`}>
          <circle class="ring" cx={s.x} cy={s.y} r="10" />
          <text class="stn" x={s.lx} y={s.ly} text-anchor={s.anchor} dominant-baseline={s.baseline}>{s.name}</text>
        </a>
      ) : (
        <g class="station" style={`--t: ${s.t}`}>
          <line class="tick" x1={s.x} y1={s.y} x2={s.x2} y2={s.y2} />
          <text class="stn" x={s.lx} y={s.ly} text-anchor={s.anchor} dominant-baseline={s.baseline}>{s.name}</text>
        </g>
      ))}
      <rect class="train" x="-12" y="-4.5" width="24" height="9" rx="4.5">
        <animateMotion dur={`${16 + L.delay / 30}s`} begin="indefinite" repeatCount="indefinite" rotate="auto" path={L.d} />
      </rect>
    </g>
  ))}

  <g class="hub" transform={`translate(${HUB.x} ${HUB.y})`}>
    <rect x="-122" y="-32" width="244" height="64" rx="32" />
    <svg x="-104" y="-19" width="76" height="38" viewBox={MARK_VIEWBOX} aria-hidden="true">
      <path d={MARK_PATH} fill="none" stroke="var(--water)" stroke-width="15" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <text class="hub-label" x="-16" y="1" dominant-baseline="middle">Lemni Works</text>
  </g>
</svg>

<style>
  .network {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-display);
  }

  .line {
    fill: none;
    stroke: var(--c);
    stroke-width: 8;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1500ms cubic-bezier(0.65, 0, 0.2, 1) var(--ld);
  }

  .network.is-live .line {
    stroke-dashoffset: 0;
  }


  .station {
    opacity: 0;
    transition: opacity 500ms ease;
    transition-delay: calc(var(--ld) + var(--t) * 1500ms);
  }

  .network.is-live .station {
    opacity: 1;
  }

  /* Destinations: real projects, drawn as rings and linked to their case studies. */
  .destination {
    cursor: pointer;
    outline: none;
  }

  .ring {
    fill: var(--water);
    stroke: var(--ink);
    stroke-width: 4;
    transition: fill 200ms ease;
  }

  .destination .stn {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--hair);
    text-underline-offset: 4px;
    transition: text-decoration-color 200ms ease;
  }

  .destination:hover .ring,
  .destination:focus-visible .ring {
    fill: var(--c);
  }

  .destination:hover .stn,
  .destination:focus-visible .stn {
    text-decoration-color: var(--ink);
  }


  .tick {
    stroke: var(--ink);
    stroke-width: 4;
    stroke-linecap: round;
  }

  .stn {
    fill: var(--ink);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .hub {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 500ms ease 1400ms;
  }

  .network.is-live .hub {
    opacity: 1;
  }

  .hub rect {
    fill: var(--ink);
    stroke: var(--water);
    stroke-width: 5;
  }

  .hub-label {
    fill: var(--water);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /* Beck's terminus: a short bar across each line's outer ends. */
  .terminus {
    stroke: var(--ink);
    stroke-width: 5;
    stroke-linecap: round;
    opacity: 0;
    transition: opacity 500ms ease calc(var(--ld) + 1400ms);
  }

  .network.is-live .terminus {
    opacity: 1;
  }

  /* A train: a small capsule in the line's colour, oriented along the track. It is started from
     script once its line has drawn, and shows only while it moves, so it is always on the rails. */
  .train {
    fill: var(--c);
    stroke: var(--water);
    stroke-width: 2;
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .train.is-moving {
    opacity: 1;
  }

  /* Selecting a line in the legend lights it and sends the others to the background. */
  .line-group {
    transition: opacity 320ms ease;
  }

  .network[data-focus] .line-group {
    opacity: 0.16;
  }

  .network[data-focus='web'] .line-group[data-line='web'],
  .network[data-focus='automation'] .line-group[data-line='automation'],
  .network[data-focus='scraping'] .line-group[data-line='scraping'],
  .network[data-focus='reports'] .line-group[data-line='reports'] {
    opacity: 1;
  }

  :global(html:not(.js)) .line {
    stroke-dashoffset: 0;
  }

  :global(html:not(.js)) .station,
  :global(html:not(.js)) .hub,
  :global(html:not(.js)) .terminus {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .line,
    .station,
    .hub,
    .terminus {
      transition-delay: 0s !important;
    }

    .train {
      display: none;
    }
  }
</style>

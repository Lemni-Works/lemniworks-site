---
import { bySlug } from '../work';
import Arrow from './Arrow.astro';
const website = bySlug('dinesense-site')!;
const apps = [bySlug('dinesense')!, bySlug('programmed')!];
const data = bySlug('apify-tools')!;
---
<section id="work" class="section" aria-labelledby="work-title">
  <div class="wrap">
    <div class="section-head reveal"><h2 id="work-title">Good ideas.<br /><span class="muted">Working things.</span></h2><p>A look at what I have designed and built, from the first screen to the systems behind it.</p></div>
    <article class="website-project reveal">
      <div class="website-copy">
        <h3 transition:name="title-dinesense-site"><a href="/work/dinesense-site">dinesense.app</a></h3>
        <p class="project-meta">{website.kind} · {website.year}</p>
        <p>A product site that lets the product do the talking.</p>
        <a class="text-link" href="/work/dinesense-site">See how it was built<Arrow diagonal /></a>
      </div>
      <a class="website-image" href="/work/dinesense-site" aria-label="View the DineSense website case study"><img src={website.images[0].src} alt={website.images[0].alt} width="1400" height="1006" loading="lazy" decoding="async" transition:name="shot-dinesense-site" /></a>
    </article>
    <div class="app-projects">
      {apps.map(p => <article class:list={['app-project reveal', p.slug]}>
        <a class="app-art" href={`/work/${p.slug}`} aria-label={`View the ${p.name} case study`}>
          <span class="art-word" aria-hidden="true">{p.name === 'DineSense' ? 'A better order.' : 'Built for the next set.'}</span>
          <div class="phone-pair">
            <img src={p.images[1].src} alt={p.images[1].alt} width={p.images[1].w} height={p.images[1].h} loading="lazy" decoding="async" />
            <img src={p.images[0].src} alt={p.images[0].alt} width={p.images[0].w} height={p.images[0].h} loading="lazy" decoding="async" transition:name={`shot-${p.slug}`} />
          </div>
          <span class="art-open" aria-hidden="true"><Arrow diagonal /></span>
        </a>
        <div class="project-info"><div><h3 transition:name={`title-${p.slug}`}><a href={`/work/${p.slug}`}>{p.name}</a></h3><p class="project-meta">{p.kind}</p><p class="project-line">{p.line}</p></div><a class="project-arrow" href={`/work/${p.slug}`} aria-label={`Read the ${p.name} case study`}><Arrow diagonal /></a></div>
      </article>)}
    </div>
    <div class="also reveal"><div><h3><a href={`/work/${data.slug}`}>{data.name}</a></h3><p>Keyword lists in. Structured datasets out.</p></div><a class="text-link" href={`/work/${data.slug}`}>Explore the data tools<Arrow diagonal /></a></div>
    <p class="work-note">The apps show my product and engineering work. Custom mobile app builds are not currently offered.</p>
  </div>
</section>
<style>
  #work { padding-top: clamp(80px, 9vw, 130px); }
  .section-head h2 { font-size: clamp(36px, 4.5vw, 62px); line-height: 1.12; }
  .section-head p { max-width: 34ch; font-size: 16px; }
  .website-project { display: grid; grid-template-columns: 0.7fr 1.3fr; background: #101817; border: 1px solid #273532; border-radius: 8px; overflow: hidden; }
  .website-copy { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: clamp(28px, 4vw, 52px); }
  .project-meta { font-size: 12px; color: var(--muted); margin-top: 12px; }
  .website-copy h3 { font-size: clamp(25px, 3vw, 40px); }
  .website-copy h3 a, .project-info h3 a, .also h3 a { text-decoration: none; }
  .website-copy > p:not(.project-meta) { font-size: 16px; color: #b5c7bf; max-width: 25ch; margin-top: 18px; }
  .website-copy .text-link { margin-top: 30px; }
  .website-image { display: flex; align-items: center; padding: 28px 0 28px 8px; overflow: hidden; }
  .website-image img { width: 108%; height: auto; display: block; border: 1px solid #35463b; border-radius: 6px; transform: rotate(-3deg) translateY(10px); transition: transform 700ms var(--ease-out); }
  .website-image:hover img { transform: rotate(0) translateY(0); }
  .app-projects { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 32px; }
  .app-art { position: relative; height: clamp(360px, 36vw, 480px); display: block; background: #151c20; overflow: hidden; border: 1px solid #30383d; border-radius: 8px; }
  .programmed .app-art { background: #191c27; border-color: #32374b; }
  .art-word { position: absolute; top: 26px; left: 28px; right: 28px; font: 500 clamp(28px, 3.4vw, 44px)/1.1 var(--font-display); letter-spacing: -0.035em; color: #b7c7c9; max-width: 10ch; }
  .programmed .art-word { color: #b5beda; }
  .phone-pair { display: flex; gap: 20px; justify-content: center; position: absolute; width: 100%; top: 100px; padding-inline: 50px; transform: rotate(-8deg); }
  .phone-pair img { display: block; width: 43%; height: auto; align-self: flex-start; border-radius: 20px; border: 1px solid #58605f; box-shadow: 0 25px 40px -15px #000b; transition: transform 650ms var(--ease-out); }
  .phone-pair img:first-child { margin-top: 75px; }
  .app-art:hover .phone-pair img:first-child { transform: translateY(-10px); }
  .app-art:hover .phone-pair img:last-child { transform: translateY(-18px); }
  .art-open { position: absolute; right: 22px; top: 24px; color: #d9e0ee; }
  .art-open :global(svg) { width: 22px; }
  .project-info { display: flex; justify-content: space-between; gap: 20px; padding-top: 24px; }
  .project-info .project-meta { margin-top: 10px; }
  .project-info h3 { font-size: 28px; }
  .project-line { color: var(--muted); font-size: 15px; max-width: 42ch; margin-top: 12px; }
  .project-arrow { display: flex; align-items: center; justify-content: center; border: 1px solid var(--hair); border-radius: 50%; width: 42px; height: 42px; flex: none; margin-top: 20px; }
  .project-arrow :global(svg) { width: 18px; }
  .project-arrow:hover { background: var(--cobalt); }
  .also { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; border-block: 1px solid var(--hair); margin-top: 52px; padding-block: 28px; }
  .also h3 { font-size: 21px; }
  .also p { font-size: 14px; color: var(--muted); margin-top: 8px; }
  .work-note { font-size: 12px; color: var(--dim); margin-top: 20px; }
  @media (max-width: 719px) {
    .website-project { grid-template-columns: 1fr; }
    .website-copy { padding: 28px; }
    .website-copy > p:not(.project-meta) { max-width: 34ch; }
    .website-image { padding: 0 0 20px 24px; }
    .app-projects { grid-template-columns: 1fr; gap: 40px; }
    .app-art { height: 420px; }
    .phone-pair { padding-inline: 48px; max-width: 500px; left: 50%; translate: -50% 0; }
    .art-word { font-size: 36px; }
    .also .text-link { font-size: 14px; }
  }
  @media (max-width: 380px) { .app-art { height: 360px; } .phone-pair { padding-inline: 30px; } }
</style>

---
import { featured, projects } from '../work';
const others = projects.filter((p) => !p.featured);
---

<section id="work" class="section" aria-labelledby="work-title">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 id="work-title">Selected work</h2>
      <p>Real screens from shipped and in-progress work. Each one opens a short case study.</p>
    </div>

    <div class="showcase">
      <div class="frame-col">
        <div class="frame">
          {
            featured.map((p, i) => (
              <a class:list={['shot', p.images[0].w > p.images[0].h ? 'wide' : 'tall']} data-shot={p.slug} href={`/work/${p.slug}`} tabindex="-1" aria-hidden="true">
                <img
                  src={p.images[0].src}
                  alt=""
                  width={p.images[0].w}
                  height={p.images[0].h}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  transition:name={`shot-${p.slug}`}
                />
              </a>
            ))
          }
        </div>
      </div>

      <ol class="items">
        {
          featured.map((p, i) => (
            <li class="item" data-item={p.slug}>
              <div class:list={['item-shot img-reveal', p.images[0].w > p.images[0].h ? 'wide' : 'tall']}>
                <img src={p.images[0].src} alt={p.images[0].alt} width={p.images[0].w} height={p.images[0].h} loading="lazy" decoding="async" />
              </div>
              <div class="item-text reveal">
                <span class="idx num dim">{String(i + 1).padStart(2, '0')}</span>
                <h3 transition:name={`title-${p.slug}`}>
                  <a href={`/work/${p.slug}`}>{p.name}</a>
                </h3>
                <p class="line">{p.line}</p>
                <p class="meta small dim">{p.kind} · {p.year}</p>
                <a class="open" href={`/work/${p.slug}`}>
                  Read the case study
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    {
      others.map((p) => (
        <div class="also reveal">
          <span class="dim small">Also</span>
          <h3><a href={`/work/${p.slug}`}>{p.name}</a></h3>
          <p class="muted">{p.line}</p>
          <a class="open" href={`/work/${p.slug}`}>
            Read more
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
          </a>
        </div>
      ))
    }
  </div>
</section>

<style>
  .showcase {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .frame-col {
    position: relative;
    align-self: stretch;
  }

  .frame {
    position: sticky;
    top: 12vh;
    height: 76vh;
    display: grid;
    place-items: center;
  }

  .shot {
    grid-area: 1 / 1;
    display: block;
    opacity: 0;
    transform: scale(0.97);
    transition:
      opacity 700ms ease,
      transform 1100ms var(--ease-out);
    pointer-events: none;
  }

  .shot.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .shot img {
    display: block;
    height: auto;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.09),
      0 60px 120px -50px rgb(0 0 0 / 0.9);
  }

  .shot.tall img {
    width: auto;
    max-height: 76vh;
    border-radius: clamp(14px, 1.8vw, 30px);
  }

  .shot.wide img {
    width: 100%;
    max-width: 100%;
    border-radius: 6px;
  }

  .items {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .item {
    min-height: 76vh;
    display: flex;
    align-items: center;
    padding-block: 12vh;
  }

  .item:first-child {
    padding-top: 0;
    min-height: 64vh;
  }

  .item-shot {
    display: none;
  }

  .item-text {
    display: grid;
    gap: 14px;
    transition: opacity 600ms ease;
  }

  .idx {
    font: 500 13px/1 var(--font-display);
    margin-bottom: 10px;
  }

  .item h3 {
    font-size: clamp(30px, 3.4vw, 44px);
    letter-spacing: -0.03em;
  }

  .item h3 a,
  .also h3 a {
    color: inherit;
    text-decoration: none;
  }

  .line {
    font-size: 17px;
    line-height: 1.5;
    color: var(--muted);
    max-width: 34ch;
  }

  .open {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: start;
    margin-top: 10px;
    font: 500 15px/1 var(--font-display);
    text-decoration: none;
    color: var(--ink);
  }

  .open svg {
    width: 14px;
    height: 14px;
    transition: transform var(--t-base) var(--ease-out);
  }

  .open:hover svg {
    transform: translateX(3px);
  }

  .also {
    margin-top: clamp(48px, 8vw, 96px);
    padding-top: 28px;
    border-top: 1px solid var(--hair);
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: 10px 24px;
    align-items: baseline;
  }

  .also h3 {
    font-size: 24px;
    letter-spacing: -0.02em;
  }

  .also .muted,
  .also .open {
    grid-column: 2;
  }

  .also .open {
    margin-top: 4px;
  }

  @media (max-width: 859px) {
    .showcase {
      grid-template-columns: 1fr;
    }

    .frame-col {
      display: none;
    }

    .item {
      min-height: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 28px;
      padding-block: 0;
    }

    .item + .item {
      margin-top: clamp(56px, 10vw, 96px);
    }

    .item-shot {
      display: block;
    }

    .item-shot img {
      display: block;
      height: auto;
      box-shadow:
        0 0 0 1px rgb(255 255 255 / 0.09),
        0 40px 80px -40px rgb(0 0 0 / 0.9);
    }

    .item-shot.tall img {
      width: min(68%, 300px);
      border-radius: 20px;
    }

    .item-shot.wide img {
      width: 100%;
      border-radius: 6px;
    }

    .also {
      grid-template-columns: 1fr;
    }

    .also .muted,
    .also .open {
      grid-column: 1;
    }
  }
</style>

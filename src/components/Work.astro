---
/* Things I've built: my own shipped work, listed as a timetable. No showcase; each row links to its
   case study. The Apify tools and Programmed keep their case-study pages but are off the homepage,
   which speaks to small-business offices. */
import { bySlug } from '../work';
import { workNote } from '../site';
import Arrow from './Arrow.astro';
const rows = [
  { line: 'depot', lineName: 'Website', p: bySlug('dinesense-site')!, runs: 'A product site that lets the product do the talking.' },
  { line: 'depot', lineName: 'App', p: bySlug('dinesense')!, runs: 'An iOS app on the App Store that turns one meal’s numbers into the exact order nearby.' },
];
---

<section id="work" class="section" aria-labelledby="work-title">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 id="work-title">Things I’ve built.</h2>
      <p>My own work, shipped and public. Each one has a case study.</p>
    </div>

    <table class="timetable reveal">
      <thead>
        <tr><th scope="col">Kind</th><th scope="col">Destination</th><th scope="col">What it does</th><th scope="col" class="num">Since</th></tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr data-line={r.line}>
            <td class="line-cell"><span class:list={['swatch', { dashed: r.line === 'depot' }]} aria-hidden="true"></span>{r.lineName}</td>
            <td class="dest"><a href={`/work/${r.p.slug}`}>{r.p.name}<Arrow diagonal /></a><span class="kind">{r.p.kind}</span></td>
            <td class="runs">{r.runs}</td>
            <td class="num since">{r.p.year}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <p class="work-note">{workNote}</p>
  </div>
</section>

<style>
  .section-head p {
    max-width: 36ch;
  }

  .timetable {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
  }

  th {
    text-align: left;
    font: 500 13px/1.3 var(--font-display);
    color: var(--dim);
    padding: 0 16px 14px 0;
    border-bottom: 1px solid var(--ink);
  }

  td {
    vertical-align: top;
    padding: 26px 16px 26px 0;
    border-bottom: 1px solid var(--hair);
  }

  .line-cell {
    white-space: nowrap;
    font: 500 14px/1.4 var(--font-display);
    color: var(--muted);
    width: 1%;
  }

  .swatch {
    display: inline-block;
    width: 28px;
    height: 7px;
    border-radius: 999px;
    background: var(--c);
    margin-right: 12px;
    vertical-align: middle;
  }

  .swatch.dashed {
    height: 0;
    border-top: 4px dashed var(--c);
    background: none;
  }

  .dest a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 500 clamp(20px, 2vw, 26px) / 1.2 var(--font-display);
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .dest a :global(svg) {
    width: 16px;
    transition: transform 200ms var(--ease-out);
  }

  .dest a:hover {
    color: var(--signal);
  }

  .dest a:hover :global(svg) {
    transform: translate(2px, -2px);
  }

  .kind {
    display: block;
    font-size: 13px;
    color: var(--dim);
    margin-top: 6px;
  }

  .runs {
    color: var(--muted);
    max-width: 44ch;
  }

  th.num,
  td.since {
    text-align: right;
    padding-right: 0;
    white-space: nowrap;
    color: var(--muted);
  }

  .work-note {
    font-size: 13px;
    color: var(--dim);
    margin-top: 20px;
  }

  @media (max-width: 720px) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    tr {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 6px 16px;
      padding-block: 22px;
      border-bottom: 1px solid var(--hair);
    }

    td {
      padding: 0;
      border: 0;
    }

    .line-cell {
      grid-column: 1;
      order: 1;
    }

    td.since {
      grid-column: 2;
      grid-row: 1;
    }

    .dest {
      grid-column: 1 / -1;
      order: 2;
    }

    .runs {
      grid-column: 1 / -1;
      order: 3;
      font-size: 15px;
    }
  }
</style>

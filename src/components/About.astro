---
import { about } from '../site';
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="wrap about">
    <div class="portrait img-reveal">
      <img src={about.portrait.src} alt={about.portrait.alt} width="599" height="900" loading="lazy" decoding="async" />
    </div>
    <div class="text reveal">
      <h2 id="about-title">One person.<br />In Wichita.</h2>
      <p class="body">{about.text}</p>
      <p class="about-signoff">Zander Erwin. Wichita, Kansas.</p>
    </div>
  </div>
</section>

<style>
  #about {
    padding-top: 0;
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .portrait {
    max-width: 330px;
    border-radius: 6px;
  }

  .portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    border-radius: 6px;
    object-fit: cover;
    object-position: center 20%;
    filter: saturate(0.85);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.09),
      0 50px 100px -50px rgb(0 0 0 / 0.9);
  }

  .text {
    display: grid;
    gap: clamp(22px, 3vw, 36px);
  }

  .text h2 {
    font-size: clamp(32px, 3.7vw, 50px);
    line-height: 1.14;
  }

  .body {
    max-width: 52ch;
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.55;
  }

  .about-signoff {
    color: var(--muted);
    font: 500 13px/1.4 var(--font-display);
  }

  @media (max-width: 719px) {
    .about {
      grid-template-columns: 1fr;
    }

    .portrait {
      max-width: 240px;
    }
  }
</style>

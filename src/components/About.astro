---
import { about } from '../site';
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="about-title">About</h2>
    </div>
    <p class="about">{about}</p>
  </div>
</section>

<style>
  .about {
    max-width: 62ch;
    font-size: 18px;
    line-height: 1.6;
  }
</style>

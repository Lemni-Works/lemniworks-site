---
import { about } from '../site';
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="wrap about">
    <div class="portrait img-reveal">
      <img src={about.portrait.src} alt={about.portrait.alt} width="599" height="900" loading="lazy" decoding="async" />
    </div>
    <div class="text reveal">
      <h2 id="about-title">About</h2>
      <p class="body">{about.text}</p>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .portrait img {
    display: block;
    width: 100%;
    max-width: 380px;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 20%;
    filter: saturate(0.85);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.09),
      0 50px 100px -50px rgb(0 0 0 / 0.9);
  }

  .text {
    display: grid;
    gap: clamp(22px, 3vw, 36px);
  }

  .body {
    max-width: 52ch;
    font-size: clamp(18px, 1.7vw, 22px);
    line-height: 1.55;
  }

  @media (max-width: 719px) {
    .about {
      grid-template-columns: 1fr;
    }

    .portrait img {
      max-width: 240px;
    }
  }
</style>

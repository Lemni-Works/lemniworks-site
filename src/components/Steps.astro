---
import { steps } from '../site';
---

<section id="how" class="section" aria-labelledby="how-title">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 id="how-title">A clear path to done.</h2>
      <p>You work with the person building it. From the first email to the final handover.</p>
    </div>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="step reveal">
            <span class="step-n num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p class="muted">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 56px);
  }

  .step {
    display: grid;
    gap: 14px;
    padding-top: 22px;
    border-top: 1px solid var(--hair);
  }

  .step-n {
    font: 500 34px/1 var(--font-display);
    color: var(--cobalt-light);
    margin-bottom: 10px;
  }

  .step h3 {
    font-size: 20px;
  }

  .step p {
    font-size: 15.5px;
    line-height: 1.5;
    max-width: 30ch;
  }

  @media (max-width: 959px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 559px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>

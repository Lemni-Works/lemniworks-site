---
/* The journey: one line, four stops, from the first message to a handed-over setup. */
import { steps } from '../site';
---

<section id="how" class="section" aria-labelledby="how-title">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 id="how-title">The journey.</h2>
      <p>From your first message to something that runs on its own. One line, four stops, and the same person at every one.</p>
    </div>
    <ol class="journey reveal">
      {steps.map((s, i) => (
        <li class="stop" style={`--d: ${i * 120}ms`}>
          <i class="dot" aria-hidden="true"></i>
          <h3>{s.title}</h3>
          <p class="muted">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .journey {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 56px);
  }

  /* The line itself, in ink, running beneath every stop. */
  .journey::before {
    content: '';
    position: absolute;
    left: 7px;
    right: 7px;
    top: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--ink);
  }

  .stop {
    position: relative;
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .stop .dot {
    width: 11px;
    height: 11px;
    margin: 5px 0 18px 5px;
    background: var(--water);
  }

  .stop h3 {
    font-size: 20px;
  }

  .stop p {
    font-size: 15.5px;
    line-height: 1.5;
    max-width: 30ch;
  }

  @media (max-width: 860px) {
    .journey {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-left: 34px;
    }

    .journey::before {
      left: 7px;
      right: auto;
      top: 7px;
      bottom: 7px;
      width: 7px;
      height: auto;
    }

    .stop .dot {
      position: absolute;
      left: -34px;
      top: 2px;
      margin: 0 0 0 5px;
    }
  }
</style>

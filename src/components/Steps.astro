---
import { steps } from '../site';
---

<section id="how" class="section" aria-labelledby="how-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="how-title">How it works</h2>
    </div>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="step">
            <span class="step-n num" aria-hidden="true">{i + 1}</span>
            <div class="step-body">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 640px;
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 0 18px;
    padding-bottom: 32px;
  }

  .step:last-child {
    padding-bottom: 0;
  }

  /* Hairline from this marker to the next, with an accent line that draws as you scroll. */
  .step:not(:last-child)::before,
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 15.5px;
    top: 32px;
    bottom: 0;
    width: 1px;
  }

  .step::before {
    background: var(--line);
  }

  .step::after {
    background: var(--accent);
    transform-origin: top;
  }

  .step-n {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--muted);
    font: 600 13px/1 var(--font-display);
  }

  .step-body {
    padding-top: 4px;
  }

  .step-body h3 {
    margin-bottom: 6px;
  }

  .step-body p {
    color: var(--muted);
    max-width: 52ch;
  }

  /* Scroll-driven progress. Browsers without it see the finished state. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .step::after {
        transform: scaleY(0);
        animation: grow linear both;
        animation-timeline: view(block 0 38%);
        animation-range: entry 0% entry 100%;
      }

      .step-n {
        animation: reach linear both;
        animation-timeline: view(block 0 38%);
        animation-range: entry 0% entry 6%;
      }
    }
  }

  @keyframes grow {
    to {
      transform: scaleY(1);
    }
  }

  @keyframes reach {
    from {
      border-color: var(--line);
      background: var(--card);
      color: var(--muted);
      box-shadow: 0 0 0 0 var(--accent-soft);
    }
    to {
      border-color: var(--accent);
      background: var(--accent);
      color: var(--accent-ink);
      box-shadow: 0 0 0 6px var(--accent-soft);
    }
  }

  @supports not (animation-timeline: view()) {
    .step-n {
      border-color: var(--accent);
      background: var(--accent);
      color: var(--accent-ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step-n {
      border-color: var(--accent);
      background: var(--accent);
      color: var(--accent-ink);
    }
  }
</style>

---
/* Drives the ink: the lemniscate injection at load, the pointer, the scroll, and hovered rows. */
---

<script>
  import { createFluid } from '../scripts/fluid';
  import { MARK_PATH } from '../mark';

  const canvas = document.getElementById('tank') as HTMLCanvasElement | null;
  const root = document.documentElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const small = matchMedia('(max-width: 719px)').matches;

  let fluid = canvas && !reduce ? createFluid(canvas, { simRes: small ? 96 : 128, dyeRes: small ? 512 : 1024 }) : null;
  if (!fluid || !fluid.supported) {
    root.classList.add('no-fluid');
    fluid = null;
  }

  if (fluid && canvas) {
    const F = fluid;
    const COBALT: [number, number, number] = [0.165, 0.357, 0.843];
    const LIGHT: [number, number, number] = [0.42, 0.576, 1.0];
    const mix = (k: number): [number, number, number] => [
      COBALT[0] + (LIGHT[0] - COBALT[0]) * k,
      COBALT[1] + (LIGHT[1] - COBALT[1]) * k,
      COBALT[2] + (LIGHT[2] - COBALT[2]) * k,
    ];
    const scale = (c: [number, number, number], s: number): [number, number, number] => [c[0] * s, c[1] * s, c[2] * s];

    // Run only while the tab is visible.
    const sync = () => F.setRunning(!document.hidden);
    document.addEventListener('visibilitychange', sync);
    sync();

    // One injection of ink draws the lemniscate, then it dissolves.
    const svgNS = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(svgNS, 'svg');
    const path = document.createElementNS(svgNS, 'path');
    path.setAttribute('d', MARK_PATH);
    svg.appendChild(path);
    svg.setAttribute('width', '0');
    svg.setAttribute('height', '0');
    svg.style.position = 'absolute';
    document.body.appendChild(svg);
    const L = path.getTotalLength();
    const aspect = () => canvas.clientWidth / canvas.clientHeight;
    const toUnit = (p: DOMPoint, cx: number, cy: number, w: number) => {
      // the final mark spans x 14..218 and y 16..104 in its own units, centred on (116, 60);
      // map width w (fraction of canvas width) to that span
      const k = w / 204;
      return { x: cx + (p.x - 116) * k, y: cy + (p.y - 60) * k * aspect() };
    };
    const inject = () => {
      const steps = 110;
      const w = small ? 0.78 : 0.46;
      const cx = small ? 0.5 : 0.58, cy = small ? 0.36 : 0.42;
      let i = 0;
      const tick = () => {
        if (i > steps) return;
        const f = i / steps;
        const a = toUnit(path.getPointAtLength(f * L), cx, cy, w);
        const b = toUnit(path.getPointAtLength(Math.min(1, f + 0.01) * L), cx, cy, w);
        const dx = (b.x - a.x) * 0.9, dy = (b.y - a.y) * 0.9;
        F.splat(a.x, a.y, dx * 0.7, dy * 0.7, scale(mix(0.3 + 0.4 * Math.sin(f * Math.PI)), 0.2), 0.003);
        i++;
        setTimeout(tick, 16);
      };
      tick();
    };
    setTimeout(inject, 350);

    // The pointer stirs the ink.
    let px = -1, py = -1, pt = 0;
    window.addEventListener('pointermove', (e) => {
      const x = e.clientX / innerWidth, y = e.clientY / innerHeight;
      const now = performance.now();
      if (px >= 0) {
        const dx = x - px, dy = y - py;
        const speed = Math.hypot(dx, dy);
        if (speed > 0.0005) F.splat(x, y, dx * 0.5, dy * 0.5, scale(mix(0.6), Math.min(0.05, speed * 2.5)), 0.0016);
      }
      px = x; py = y; pt = now;
    }, { passive: true });
    window.addEventListener('pointerleave', () => { px = py = -1; });

    // Scrolling pushes the ink.
    let lastY = scrollY;
    window.addEventListener('scroll', () => {
      const d = (scrollY - lastY) / innerHeight;
      lastY = scrollY;
      if (Math.abs(d) < 0.002) return;
      const y = 0.5 + Math.random() * 0.3;
      for (let i = 0; i < 3; i++) {
        const x = 0.15 + Math.random() * 0.7;
        F.splat(x, y, 0, -d * 0.4, scale(COBALT, 0.05), 0.008);
      }
    }, { passive: true });

    // A hovered row breathes a little ink behind it.
    for (const el of document.querySelectorAll<HTMLElement>('[data-ink]')) {
      el.addEventListener('pointerenter', () => {
        const r = el.getBoundingClientRect();
        const x = (r.left + r.width * 0.35) / innerWidth, y = (r.top + r.height / 2) / innerHeight;
        F.splat(x, y, 0.004, 0, scale(mix(0.5), 0.07), 0.012);
      });
    }

    // Idle drift so the tank never goes fully dead.
    setInterval(() => {
      if (document.hidden) return;
      const x = 0.2 + Math.random() * 0.6, y = 0.25 + Math.random() * 0.5;
      const a = Math.random() * Math.PI * 2;
      F.splat(x, y, Math.cos(a) * 0.003, Math.sin(a) * 0.003, scale(mix(Math.random()), 0.09), 0.014);
    }, 2200);
  }
</script>

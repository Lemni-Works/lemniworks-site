---
import Mark from './Mark.astro';
import { site } from '../site';
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <Mark class="brand-mark" />
      <picture class="brand-name" aria-hidden="true">
        <source srcset="/logo-wordmark-white.svg" media="(prefers-color-scheme: dark)" />
        <img src="/logo-wordmark.svg" alt="" width="809" height="115" />
      </picture>
    </a>
    <nav aria-label="Primary">
      <a href="/#services">Services</a>
      <a href="/#work">Work</a>
      <a href="/#contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    height: var(--header-h);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    z-index: 50;
  }

  @media (min-width: 720px) {
    .site-header {
      position: sticky;
      top: 0;
      background: color-mix(in srgb, var(--bg) 86%, transparent);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
    }
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8.4px;
    color: var(--ink);
    text-decoration: none;
  }

  .brand :global(.brand-mark) {
    height: 18px;
    width: auto;
    color: var(--ink);
  }

  .brand :global(.brand-mark .mark-stroke) {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 900ms var(--ease-out);
  }

  /* On desktop the big hero mark is the brand; the small one draws in once it scrolls away. */
  @media (min-width: 720px) {
    :global(html.js.hero-visible) .brand :global(.brand-mark .mark-stroke) {
      stroke-dashoffset: 1;
      transition-duration: 300ms;
    }
  }

  .brand-name {
    display: block;
    flex: none;
    width: 119.4px;
    transition: transform 900ms var(--ease-out);
  }

  .brand-name img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* While the big mark is on screen the small one is absent; the name sits at the gutter edge. */
  @media (min-width: 720px) {
    :global(html.js.hero-visible) .brand-name {
      transform: translateX(-43.2px);
      transition-duration: 300ms;
    }
  }

  @media (max-width: 719px) {
    .brand {
      gap: 7.3px;
    }

    .brand-name {
      width: 104px;
    }

    .brand :global(.brand-mark) {
      height: 15.6px;
    }
  }

  nav {
    display: flex;
    gap: clamp(14px, 3vw, 28px);
  }

  nav a {
    position: relative;
    font-size: 15px;
    color: var(--muted);
    text-decoration: none;
    padding-block: 6px;
    transition: color var(--t-fast) ease;
  }

  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-base) var(--ease-out);
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--ink);
  }

  nav a:hover::after,
  nav a:focus-visible::after {
    transform: scaleX(1);
  }

  @media (max-width: 719px) {
    .header-inner { gap: 12px; }
    nav { gap: 12px; }
    nav a { font-size: 14px; }
  }
</style>

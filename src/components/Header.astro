---
import Mark from './Mark.astro';
import { site } from '../site';
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <Mark class="brand-mark" />
      <img class="brand-name" src="/logo-wordmark-white.svg" alt="" width="809" height="115" />
    </a>
    <nav aria-label="Primary">
      <a href="#services">Services</a>
      <a href="#work">Work</a>
      <a href="#contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    pointer-events: none;
    /* a scrim so the rail stays legible over whatever scrolls beneath it */
    background: linear-gradient(to bottom, rgb(6 7 10 / 0.92) 0%, rgb(6 7 10 / 0.6) 55%, transparent 100%);
    padding-bottom: 28px;
  }

  .header-inner {
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand,
  nav {
    pointer-events: auto;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
  }

  .brand :global(.brand-mark) {
    height: 20px;
    width: auto;
  }

  .brand-name {
    height: 15px;
    width: auto;
    display: block;
  }

  nav {
    display: flex;
    gap: clamp(18px, 3vw, 36px);
  }

  nav a {
    position: relative;
    font: 500 14.5px/1 var(--font-display);
    color: var(--muted);
    text-decoration: none;
    padding-block: 8px;
    transition: color var(--t-fast) ease;
  }

  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-base) var(--ease-out);
  }

  nav a:hover,
  nav a:focus-visible,
  nav a.is-current {
    color: var(--ink);
  }

  nav a:hover::after,
  nav a.is-current::after {
    transform: scaleX(1);
  }

  @media (max-width: 719px) {
    .header-inner {
      height: 64px;
    }

    nav a {
      font-size: 14px;
    }
  }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]')];
  const targets = links.map((l) => document.getElementById(l.hash.slice(1))).filter(Boolean) as HTMLElement[];
  if (targets.length) {
    const ratios = new Map<Element, number>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) ratios.set(e.target, e.isIntersecting ? e.intersectionRatio : 0);
        let best: Element | null = null, bestR = 0;
        for (const [el, r] of ratios) if (r > bestR) { bestR = r; best = el; }
        for (const l of links) l.classList.toggle('is-current', !!best && l.hash.slice(1) === (best as HTMLElement).id);
      },
      { threshold: [0, 0.2, 0.4, 0.6], rootMargin: '-30% 0px -50% 0px' }
    );
    targets.forEach((t) => io.observe(t));
  }
</script>

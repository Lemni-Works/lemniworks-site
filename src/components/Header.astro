---
import Mark from './Mark.astro';
import Arrow from './Arrow.astro';
import { site } from '../site';
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <Mark class="brand-mark" />
      <img class="brand-name" src="/logo-wordmark-white.svg" alt="" width="809" height="115" />
    </a>
    <nav aria-label="Primary">
      <a href="/#lines">What I set up</a>
      <a href="/#work">Built</a>
      <a href="/#contact" class="nav-contact">Let’s talk <Arrow diagonal /></a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    pointer-events: none;
    /* frosted scrim: whatever scrolls beneath stays legible, and the rail reads as glass */
    background: rgb(18 17 16 / 0.72);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    backdrop-filter: blur(18px) saturate(150%);
    border-bottom: 1px solid var(--hair-soft);
  }

  .header-inner {
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand,
  nav {
    pointer-events: auto;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
  }

  .brand :global(.brand-mark) {
    height: 20px;
    width: auto;
  }

  .brand-name {
    height: 15px;
    width: auto;
    display: block;
    clip-path: inset(-4px 0 -4px 0);
    transition: clip-path 760ms var(--ease-out) 80ms;
  }

  /* While the entrance plays, the real mark stays out of sight: the intro's copy lands in its slot.
     The wordmark wipes in from behind the mark once it has landed. */
  :global(html.intro) .brand :global(.brand-mark),
  :global(html.intro-mark) .brand :global(.brand-mark) {
    visibility: hidden;
  }

  :global(html.intro) .brand-name,
  :global(html.intro-mark) .brand-name {
    clip-path: inset(-4px 100% -4px 0);
    transition: none;
  }

  nav {
    display: flex;
    gap: clamp(18px, 3vw, 36px);
    transition: opacity 700ms ease 200ms;
  }

  :global(html.intro) nav {
    opacity: 0;
    transition: none;
  }

  nav a {
    position: relative;
    font: 500 14.5px/1 var(--font-display);
    color: var(--muted);
    text-decoration: none;
    padding-block: 12px;
    transition: color var(--t-fast) ease;
  }

  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-base) var(--ease-out);
  }

  nav a:hover,
  nav a:focus-visible,
  nav a.is-current {
    color: var(--ink);
  }

  nav a:hover::after,
  nav a.is-current::after {
    transform: scaleX(1);
  }

  .nav-contact {
    color: var(--ink);
  }

  .nav-contact :global(svg) {
    color: var(--signal);
    margin-left: 5px;
    width: 13px;
    height: 13px;
  }

  @media (max-width: 719px) {
    .header-inner {
      height: 64px;
    }

    nav a {
      font-size: 14px;
    }
  }

  @media (max-width: 420px) {
    .brand {
      gap: 7px;
    }

    .brand :global(.brand-mark) {
      height: 17px;
    }

    .brand-name {
      height: 12px;
    }

    nav {
      gap: 16px;
    }

    nav a {
      font-size: 12px;
    }

    .nav-contact :global(svg) {
      display: none;
    }
  }
</style>

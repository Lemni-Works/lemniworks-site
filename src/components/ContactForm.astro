---
import Mark from './Mark.astro';
import { site, email, budgets } from '../site';
const action = `${site.workerOrigin}/api/contact`;
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="contact-title">Contact</h2>
      <p>Tell me what you need in your own words. I read every message myself.</p>
    </div>

    <div id="sent" class="card sent" role="status" hidden>
      <Mark class="sent-mark" />
      <div>
        <p class="sent-title">Got it.</p>
        <p class="muted">I will reply within {site.replyWindow}.</p>
      </div>
    </div>

    <form class="card form" method="post" action={action}>
      <div class="row two">
        <div class="field">
          <label for="f-name">Name <span class="muted">(optional)</span></label>
          <input id="f-name" name="name" type="text" autocomplete="name" />
        </div>
        <div class="field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required />
        </div>
      </div>

      <div class="field">
        <label for="f-need">What do you need?</label>
        <textarea id="f-need" name="message" rows="5" required></textarea>
      </div>

      <div class="field">
        <label for="f-budget">Rough budget</label>
        <div class="select-wrap">
          <select id="f-budget" name="budget">
            {budgets.map((b) => <option value={b}>{b}</option>)}
          </select>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 6.5l4 4 4-4"></path>
          </svg>
        </div>
      </div>

      <div class="hp" aria-hidden="true">
        <label for="f-website">Website</label>
        <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="actions">
        <button class="btn" type="submit">
          Send
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4"></path>
          </svg>
        </button>
      </div>
    </form>

    <p class="small muted alt">Prefer email? <a href={`mailto:${email}`}>{email}</a></p>
  </div>
</section>

<style>
  .form {
    padding: 24px;
    display: grid;
    gap: 18px;
  }

  @media (min-width: 720px) {
    .form {
      padding: 28px;
    }
  }

  .row.two {
    display: grid;
    gap: 18px;
  }

  @media (min-width: 560px) {
    .row.two {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field {
    display: grid;
    gap: 7px;
  }

  label {
    font: 600 14.5px/1.3 var(--font-display);
  }

  label .muted {
    font-weight: 500;
  }

  input,
  textarea,
  select {
    width: 100%;
    margin: 0;
    padding: 11px 13px;
    font: inherit;
    font-size: 16px;
    line-height: 1.4;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    transition:
      border-color var(--t-fast) ease,
      box-shadow var(--t-fast) ease;
  }

  textarea {
    resize: vertical;
    min-height: 120px;
  }

  input:hover,
  textarea:hover,
  select:hover {
    border-color: color-mix(in srgb, var(--line) 40%, var(--muted));
  }

  input:focus,
  textarea:focus,
  select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  input:user-invalid,
  textarea:user-invalid {
    border-color: #c0392b;
  }

  .select-wrap {
    position: relative;
  }

  select {
    appearance: none;
    -webkit-appearance: none;
    padding-right: 40px;
    cursor: pointer;
  }

  .select-wrap svg {
    position: absolute;
    right: 13px;
    top: 50%;
    width: 16px;
    height: 16px;
    transform: translateY(-50%);
    color: var(--muted);
    pointer-events: none;
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .actions {
    display: flex;
    justify-content: flex-start;
  }

  .alt {
    margin-top: 16px;
  }

  .sent[hidden] {
    display: none;
  }

  .sent {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px 22px;
    margin-bottom: 16px;
    border-color: var(--accent-line);
    background: color-mix(in srgb, var(--accent-soft) 50%, var(--card));
  }

  .sent :global(.sent-mark) {
    flex: none;
    width: 76px;
    color: var(--accent);
  }

  .sent :global(.sent-mark .mark-stroke) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1300ms var(--ease-out) 150ms forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .sent-title {
    font: 600 18px/1.3 var(--font-display);
  }
</style>

<script>
  // The Worker redirects to /?sent=1 after a successful submission.
  const params = new URLSearchParams(location.search);
  if (params.get('sent') === '1') {
    const box = document.getElementById('sent');
    if (box) {
      box.hidden = false;
      box.scrollIntoView({ block: 'center' });
      params.delete('sent');
      const q = params.toString();
      history.replaceState(null, '', location.pathname + (q ? `?${q}` : '') + '#contact');
    }
  }
</script>

---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  index?: boolean;
  image?: string;
}
const { title = site.title, description = site.description, index = true, image = '/og-image.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? `https://${site.domain}`);
const og = new URL(image, canonical);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!index && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#121110" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (function (d) {
        d.classList.add('js');
        /* The Open Path entrance plays once per session on the home page, and never under reduced motion.
           Deciding here, before first paint, is what keeps the page from flashing before the intro. */
        try {
          if (location.pathname === '/' && !sessionStorage.getItem('lw-intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            d.classList.add('intro', 'intro-mark');
          }
        } catch (e) {}
      })(document.documentElement);
    </script>
    <ClientRouter />
  </head>
  <body>
    <!--
      DIRECTION · The Network Map · seed 3f6d29da · chosen by the user from the third hand (Impeccable's pick).
      THESIS: a one-person studio drawn as a transit network: the tools a shop already pays for are
      stations, the four services are four coloured lines, and every line changes trains at one hub,
      the builder. It refuses the dark-SaaS hero with tabs and cards.
      OWN-WORLD: warm graphite ground, bone ink, Beck geometry (horizontal, vertical, 45°, rounded
      bends), four line colours as one ember scheme (sand, amber, tangerine, rust), white station ticks and rings, the
      Open Path mark inside the hub capsule, Manrope labels in sentence case, pill buttons like stations.
      STORY: the visitor finds their line within a scroll, sees it proven with real work or a working
      example, understands one person runs every line, and files a request.
      FIRST VIEWPORT: the map fills the viewport; headline and the one action sit in the empty
      north-west quadrant; the lines draw themselves after the mark lands in the header; the legend
      beneath selects a line and lights it. Trains run slowly along every line.
      FORM: Beck transit diagram, rank 1 on the grounded list, presented as the pick beside the roll.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review,
      the verdict, DESIGN.md, and every shipping raster carrying its provenance.
    -->
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

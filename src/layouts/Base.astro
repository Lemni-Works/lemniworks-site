---
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Pass false on pages that should not be indexed. */
  index?: boolean;
}
const { title = site.title, description = site.description, index = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? `https://${site.domain}`);
const og = new URL('/og-image.png', canonical);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!index && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfbfc" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121317" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <!--
      DIRECTION
      THESIS: A one-person engineering shop should look like its own workbench, not a SaaS landing page.
      The page refuses floating gradient blobs and screenshot mockups; the mark is the only picture.
      OWN-WORLD: drafting-paper white (or lamp-black), one ink, one pen-blue accent, hairlines, Manrope
      headings on a system body, a monoline mark with round terminals that is also the pictogram language.
      Motion material is one idea everywhere: a stroke drawing itself, and data moving along it.
      STORY: "This person builds precise, finished things and will quote me a number." Then: send the form.
      FIRST VIEWPORT: header hairline; the open lemniscate at 640px on faint dot grid, drawn in once, with
      data particles entering lower-left, pulsing at the crossing, leaving at the upper-right gap;
      H1 below-left, 40-word lede, one blue button, one quiet line about reply time.
      FORM: single column, 860px measure, cards only where the brief asks for cards. Seed: lemni-bench-01.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review,
      the verdict, DESIGN.md, and every shipping raster carrying its provenance.
    -->
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

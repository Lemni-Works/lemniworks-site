---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  index?: boolean;
  image?: string;
}
const { title = site.title, description = site.description, index = true, image = '/og-image.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? `https://${site.domain}`);
const og = new URL(image, canonical);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!index && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#06070a" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter />
  </head>
  <body>
    <!--
      DIRECTION
      THESIS: A black gallery. The work is the only picture; type and hairlines do the rest. It refuses the
      dark agency landing (glow hero, icon cards, thumbnail grid), the box grid, and abstract atmosphere.
      OWN-WORLD: #06070A black with generous empty space; white Manrope 500 at display scale; hairlines at
      12% white; real screens with a thin rim of light and deep shadow; one cobalt used sparingly for
      numerals and focus. No containers except the glass the form sits on.
      STORY: "This studio ships finished, specific things; here they are, large, and I can read exactly
      what was built." Then: send the form.
      FIRST VIEWPORT: black. Wordmark top-left, three links top-right. Headline "One studio for the whole
      shop." lower-left at 8vw rising into place line by line, the lede and one white pill button under it,
      the four services as a quiet line. Below the fold the first project uncovers from the bottom.
      SIGNATURE: the pinned showcase. A sticky frame holds a large screen that crossfades as each project's
      name scrolls past; clicking carries the screen and the title into the case-study page as shared
      elements. Motion grammar: rise, uncover, crossfade, travel. Nothing slides sideways, nothing bounces.
      FORM: user-pinned (minimalist, clean animations, black space, a better showcase) after Ink in Water
      was judged too abstract; round four; seed 61058b97.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review,
      the verdict, DESIGN.md, and every shipping raster carrying its provenance.
    -->
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  index?: boolean;
  image?: string;
}
const { title = site.title, description = site.description, index = true, image = '/og-image.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? `https://${site.domain}`);
const og = new URL(image, canonical);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!index && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#080b10" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (function (d) {
        d.classList.add('js');
        /* The Open Path entrance plays once per session on the home page, and never under reduced motion.
           Deciding here, before first paint, is what keeps the page from flashing before the intro. */
        try {
          if (location.pathname === '/' && !sessionStorage.getItem('lw-intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            d.classList.add('intro', 'intro-mark');
          }
        } catch (e) {}
      })(document.documentElement);
    </script>
    <ClientRouter />
  </head>
  <body>
    <!--
      DIRECTION · Connected Studio · code-led, design choice delegated by the user.
      THESIS: Make the studio's four services tangible through an interactive working display.
      OWN-WORLD: Ink #080b10, cobalt #2a5bd7, pale-blue accents, Manrope, precise seams,
      purposeful browser and device frames. Real projects carry the photography.
      STORY: Try the services, inspect real work, identify a problem, contact the builder.
      FIRST VIEWPORT: Large three-line headline left; a cobalt-backed service demo right;
      two actions beneath the copy, four equal service doors across the lower edge.
      FORM: Connected workbench; grounded candidate 3; seed 1359107d. User requested a
      balanced mix of all four services and delegated visual decisions. Signature: switch
      website, workflow, data and report views; run a sample workflow and export sample data.
      ENTRANCE: once per session the Open Path mark draws itself, then travels into the header
      while the hero rises. Skippable, reduced-motion aware, never replays on client navigation.
      FINISH: reviewed in the browser at desktop and phone widths; DESIGN.md records the decisions;
      every shipping raster carries its provenance in an adjacent .json.
    -->
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
